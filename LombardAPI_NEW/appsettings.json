    "FromEmail": "lomad@icicilombard.com",
    "ToEmail": "ruchita.kamble@ext.icicilombard.com",
    "SmtpHost": "smtp.prodicicilombard.com",
    "SmtpPort": "465",
    "Username": "aykkamble098@gmail.com",
    "Password": "azll hgef pyxb kjxj"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Lombard-GAL;Username=postgres;Password=CDP@2025"
  },
  "PowerShellCommands": {
    "Membership": {
      "OnPrem": {
        "Get": "Get-ADGroup -Identity \"{dlName}\" -Properties ManagedBy | ConvertTo-Json -Depth 5",
        "ManagedBy": "Get-ADUser -Identity \"{managedByDn}\" -Properties DisplayName,SamAccountName | Select-Object DisplayName,SamAccountName | ConvertTo-Json",
        "Add": "Add-ADGroupMember -Identity \"{DLName}\" -Members \"{User}\"",
        "Remove": "Remove-ADGroupMember -Identity \"{DLName}\" -Members \"{User}\" -Confirm:$false"
      },
      "Cloud": {
        "Get": "Get-ADGroup -Identity \"{dlName}\" -Properties ManagedBy | ConvertTo-Json -Depth 5",
        "ManagedBy": "Get-ADGroup -Identity \"{DLName}\" | Select-Object ManagedBy | ConvertTo-Json",
        "Add": "Add-DistributionGroupMember -Identity \"{DLName}\" -Member \"{User}@icicilombard.com\" -Confirm:$false",
        "Remove": "Remove-DistributionGroupMember -Identity \"{DLName}\" -Member \"{User}@icicilombard.com\" -Confirm:$false"
      }
    },
    "Rights": {
      "OnPrem": {
        "Add": "Set-DistributionGroup -Identity \"{DLName}\" -AcceptMessagesOnlyFrom @{{Add=\"{Rights}\"}}",
        "Remove": "Set-DistributionGroup -Identity \"{DLName}\" -AcceptMessagesOnlyFrom @{{Remove=\"{Rights}\"}}"
      },
      "Cloud": {
        "Add": "$group = Get-AzureADGroup -SearchString \"{DLName}\"; $user = Get-AzureADUser -ObjectId \"{Rights}\"; Add-AzureADGroupMember -ObjectId $group.ObjectId -RefObjectId $user.ObjectId",
        "Remove": "$group = Get-AzureADGroup -SearchString \"{DLName}\"; $user = Get-AzureADUser -ObjectId \"{Rights}\"; Remove-AzureADGroupMember -ObjectId $group.ObjectId -MemberId $user.ObjectId"
      }
    },
    "GAL": {
      "EmpId": "Get-ADUser -Filter { SamAccountName -like \"*{Value}*\" } -Properties *  | ConvertTo-Json",
      "FirstName": "Get-ADUser -Filter { GivenName -like \"*{Value}*\" } -Properties *",
      "LastName": "Get-ADUser -Filter { Surname -like \"*{Value}*\" } -Properties *",
      "Mail": "Get-ADUser -Filter { Mail -like \"*{Value}*\" } -Properties *",
      "DisplayName": "Get-ADUser -Filter { DisplayName -like \"*{Value}*\" } -Properties *"
    },
    "AccountUnlock": {
      "Unlock": "Unlock-ADAccount -Identity \"{EmpId}\"",
      "Verify": "Get-ADUser -Identity \"{EmpId}\" -Properties LockedOut | Select SamAccountName, LockedOut | ConvertTo-Json"
    } 
  },
  "AllowedHosts": "*"
}
