<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for LombardAPI_NEW.
  Contains ONLY the ASP.NET Core handler and security headers.
  No secrets / connection strings are stored here (those come from
  environment variables).
-->
<configuration>
	<system.webServer>

		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>
		<aspNetCore processPath="dotnet"
					arguments=".\LombardAPI_NEW.dll"
					stdoutLogEnabled="false"
					stdoutLogFile=".\logs\stdout"
					hostingModel="inprocess" />

		<!-- HSTS declared in configuration (Checkmarx WebConfig\Missing HSTS Header). -->
		<hsts enabled="true" max-age="31536000" includeSubDomains="true" redirectHttpToHttps="true" />

		<!-- Strip server-identifying headers (Information Exposure via Headers). -->
		<security>
			<requestFiltering removeServerHeader="true" />
		</security>
		<httpProtocol>
			<customHeaders>
				<!-- Security headers (Missing CSP + Missing Framing Policy). -->
				<add name="Content-Security-Policy" value="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" />
				<add name="X-Frame-Options" value="DENY" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="Referrer-Policy" value="no-referrer" />
				<add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
				<!-- Remove headers that leak server/technology info. -->
				<remove name="X-Powered-By" />
				<remove name="Server" />
			</customHeaders>
		</httpProtocol>

	</system.webServer>
</configuration>